# Advance AI Research Assistant — example configuration
# Copy to .env. Never commit .env or real API keys.

APP_NAME=Advance AI Research Assistant
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Local LLM provider (Ollama server must be installed separately)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Optional cloud providers — add your own key only if you choose that provider
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Storage
CHROMA_PERSIST_DIRECTORY=./data/chroma
SQLITE_DATABASE_URL=sqlite:///./data/app.db

# Embedding configuration
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=

# Initial retrieval defaults; tune using evaluation
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
